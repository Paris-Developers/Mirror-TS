{
	"compilerOptions": {
		"target": "es2023",
		// nodenext lets this CommonJS project import ESM-only packages (enmap, tslog) via Node's require(esm)
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": ".",
		"outDir": "./built",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["./src/**/*"]
}
