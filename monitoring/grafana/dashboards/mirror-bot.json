		{
			"id": 12,
			"type": "timeseries",
			"title": "Bot connections (Discord, voice, web APIs)",
			"description": "Traffic on connections the bot opens itself, counted inside the bot. Voice audio is what Mirror streams into voice channels. Discord and web API traffic is counted after decryption, so it reads a little low. Song downloads are shown separately.",
			"datasource": {
				"type": "prometheus",
				"uid": "mirror-prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 15
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "mirror-prometheus"
					},
					"refId": "A",
					"expr": "rate(mirror_network_bytes_total{protocol=\"udp\",direction=\"sent\"}[$__rate_interval]) * 8",
					"legendFormat": "Voice audio sent",
					"range": true,
					"instant": false
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "mirror-prometheus"
					},
					"refId": "B",
					"expr": "rate(mirror_network_bytes_total{protocol=\"udp\",direction=\"received\"}[$__rate_interval]) * 8",
					"legendFormat": "Voice received",
					"range": true,
					"instant": false
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "mirror-prometheus"
					},
					"refId": "C",
					"expr": "rate(mirror_network_bytes_total{protocol=\"tcp\",direction=\"received\"}[$__rate_interval]) * 8",
					"legendFormat": "Discord and web APIs received",
					"range": true,
					"instant": false
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "mirror-prometheus"
					},
					"refId": "D",
					"expr": "rate(mirror_network_bytes_total{protocol=\"tcp\",direction=\"sent\"}[$__rate_interval]) * 8",
					"legendFormat": "Discord and web APIs sent",
					"range": true,
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bps",
					"min": 0,
					"custom": {
						"drawStyle": "line",
						"lineWidth": 1,
						"fillOpacity": 15,
						"showPoints": "never",
						"stacking": {
							"mode": "none",
							"group": "A"
						},
						"spanNulls": false
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 13,
			"type": "timeseries",
			"title": "Song downloads and helper program activity",
			"description": "Data read and written by the helper programs Mirror starts for each song. yt-dlp read is roughly the song download from YouTube; Windows counts network and disk together for a program.",
			"datasource": {
				"type": "prometheus",
				"uid": "mirror-prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 15
