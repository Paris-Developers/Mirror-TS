		{
			"id": 8,
			"type": "row",
			"title": "PC resources used by the bot (only programs run by the mirrorbot account)",
			"collapsed": false,
			"gridPos": {
				"h": 1,
				"w": 24,
				"x": 0,
				"y": 5
			},
			"panels": []
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "CPU, as a share of the whole PC",
			"description": "CPU used by the bot (node) and the programs it starts for each song: yt-dlp downloads audio and ffmpeg converts it. 100% would be every core on the PC. Only processes run by the mirrorbot account are counted, so games and Moonlight never show up here.",
			"datasource": {
				"type": "prometheus",
				"uid": "mirror-prometheus"
			},
			"gridPos": {
				"h": 8,
				"w": 8,
				"x": 0,
				"y": 6
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "mirror-prometheus"
					},
					"refId": "A",
					"expr": "sum by (process) (rate(windows_process_cpu_time_total[$__rate_interval]) * on(process_id) group_left() windows_process_info{owner=~\"(?i).*mirrorbot.*\"}) / scalar(count(windows_cpu_time_total{mode=\"idle\"})) * 100",
					"legendFormat": "{{process}}",
					"range": true,
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"custom": {
						"drawStyle": "line",
						"lineWidth": 1,
						"fillOpacity": 15,
						"showPoints": "never",
						"stacking": {
							"mode": "normal",
							"group": "A"
						},
						"spanNulls": false
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			}
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Memory, as a share of the whole PC",
			"description": "Memory used by the bot and its helper programs, as a share of the PC's installed memory. Only processes run by the mirrorbot account are counted.",
			"datasource": {
				"type": "prometheus",
				"uid": "mirror-prometheus"
